{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "outputs": ["reports/mutation/**"]
    },
    "db:seed": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test:bdd": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../features/**"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build", "@sol-a-sol/api#build"],
      "cache": false
    },
    "openapi:export": {
      "dependsOn": ["build"],
      "cache": false
    },
    "api:client": {
      "dependsOn": ["@sol-a-sol/api#openapi:export"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
