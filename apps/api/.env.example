# Copiar a apps/api/.env y ajustar. Nunca versionar .env.
PORT=3001
DATABASE_URL=postgresql://sol_a_sol:sol_a_sol@localhost:5432/sol_a_sol?schema=public

# Quién puede crear una cuenta: closed | invite | open.
# Cualquier otro valor (o la variable sin definir) se entiende como `closed`.
# `closed` deja registrarse solo a la primera persona, que queda como dueña de la plataforma.
REGISTRATION_MODE=closed
# Solo con REGISTRATION_MODE=invite. Sin código configurado no se deja entrar a nadie.
REGISTRATION_INVITE_CODE=

# Clave con la que se firman los tokens de acceso. Mínimo 32 bytes (HS256 usa 256 bits).
# Generar una propia y nunca reutilizarla entre entornos:  openssl rand -base64 48
AUTH_JWT_SECRET=

# Clave con la que se cifran los secretos del segundo factor. Exactamente 32 bytes en base64.
# Es propia y no la de los JWT: rotar aquella no puede dejar a nadie fuera de su 2FA.
#   openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=

# Tope de peticiones por minuto y por IP. Sin definir: 120 en general y 20 en /auth, que es
# más estricto porque ahí cada petición cuesta un hash argon2id. Un valor que no sea un entero
# positivo se ignora y se usa el de por defecto.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# Cuántos proxies hay delante de la API (0 = ninguno, que es lo normal en desarrollo).
# Importa porque la IP decide el tope de peticiones y el bloqueo por intentos fallidos: detrás
# de un proxy sin esto todas las peticiones parecerían venir de la misma IP. Poner el número
# real de saltos; de más, cualquiera podría falsear su IP con X-Forwarded-For.
TRUST_PROXY=0

# Detalle de los logs (JSON con pino): trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# Desde qué orígenes acepta llamadas del navegador, separados por comas. Nunca `*`: la sesión
# viaja en una cookie. Sin definir, solo la web local.
WEB_ORIGIN=http://localhost:3000

# Feature flags: un módulo se activa solo con el valor exacto `true`.
# Los módulos en construcción se integran a main apagados.
# `identity` quedó encendido al cerrar H2: registro, sesión, segundo factor, tokens del celular,
# límite de intentos y bitácora.
FEATURE_IDENTITY=true
FEATURE_CATALOG=false
FEATURE_TRANSACTIONS=false
FEATURE_BUDGETING=false
FEATURE_CREDIT_CARDS=false
FEATURE_GOALS=false
FEATURE_REPORTS=false
FEATURE_CAPTURE=false
