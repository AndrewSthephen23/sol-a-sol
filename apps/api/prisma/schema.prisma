generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// La URL de conexión vive en prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

/// Usuario de la plataforma. El modelo es multiusuario desde el día 1:
/// todas las tablas de negocio referenciarán `User.id`.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  /// Secreto TOTP **cifrado** con AES-256-GCM. Existe desde que se empieza a activar el
  /// segundo factor, pero este no vale hasta que `totpConfirmedAt` deja de ser nulo.
  totpSecret      String?   @map("totp_secret")
  /// Cuándo se confirmó el segundo factor con un código. Nulo = no está activo.
  totpConfirmedAt DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Último periodo de 30 s usado. Impide reutilizar un código dentro de su ventana.
  totpLastCounter BigInt?   @map("totp_last_counter")
  locale          String    @default("es-PE")
  timezone        String    @default("America/Lima")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  personalAccessTokens PersonalAccessToken[]
  refreshTokens        RefreshToken[]
  recoveryCodes        RecoveryCode[]
  categories           Category[]
  paymentMethods       PaymentMethod[]
  transactions         Transaction[]
  transfers            Transfer[]
  tags                 Tag[]
  budgets              Budget[]
  budgetLines          BudgetLine[]
  creditCards          CreditCard[]

  @@map("users")
}

/// Código de recuperación del segundo factor: la salida cuando se pierde el teléfono.
///
/// Se guarda solo su hash SHA-256, como los refrescos y por el mismo motivo: son símbolos
/// aleatorios, no un secreto que alguien elija, y hay que poder buscarlos en un índice.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  /// Cada código sirve una sola vez.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Sesión abierta en un navegador. El valor solo existe en la cookie del cliente: aquí se guarda
/// su hash SHA-256, así que una filtración de la base no permite suplantar a nadie.
///
/// Se usa SHA-256 y no argon2id a propósito: argon2 es lento **por diseño**, para proteger
/// secretos que elige una persona y se pueden adivinar. Este token son 256 bits aleatorios, que
/// no se adivinan, y el hash tiene que poder buscarse en un índice en cada refresco.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Cuándo se canjeó. Que llegue un token ya canjeado significa que alguien lo copió.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de larga duración para que un dispositivo (el celular) use la API sin la contraseña.
/// Solo se guarda su hash: el valor se muestra una vez al crearlo y no se puede recuperar.
///
/// El token lleva dentro su `id` (`sas_pat_<id><secreto>`), así que se busca por clave primaria
/// y el hash se compara en tiempo constante; por eso `tokenHash` no necesita índice.
model PersonalAccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Nombre del dispositivo ("iPhone"), para poder revocar uno solo.
  name       String
  /// SHA-256 del secreto. Son 256 bits aleatorios: argon2 no aportaría nada (ver `RefreshToken`).
  tokenHash  String    @map("token_hash")
  /// Permisos mínimos del token; hoy solo existe `captures:write`.
  scopes     String[]
  /// Última vez que se usó, para saber si el token sigue vivo.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Siempre caduca: entre 1 y 365 días desde que se crea, 90 por defecto.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

/// Intentos fallidos de inicio de sesión de una llave, para el bloqueo progresivo.
///
/// Hay **dos llaves por intento** y se cuentan por separado: el correo (exista o no la cuenta)
/// y la IP. Solo por IP no protegería —quien tiene muchas IPs probaría sin freno—, y solo por
/// cuenta permitiría dejar a alguien fuera a propósito; con las dos, el tope de 15 minutos
/// limita cuánto puede durar eso.
///
/// El correo **no se guarda en claro**: la llave es `email:<sha256>`. Así la tabla no es una
/// lista de correos que alguien intentó, y aun así dos intentos contra el mismo correo caen en
/// la misma fila. La IP sí va tal cual: hay que poder leerla al investigar.
///
/// A propósito **sin clave foránea** hacia `User`: un intento contra un correo que no existe
/// no tiene usuario, y es justamente el caso que hay que frenar.
model LoginThrottle {
  key           String    @id
  failures      Int       @default(0)
  lastFailureAt DateTime  @map("last_failure_at") @db.Timestamptz(3)
  /// Hasta cuándo no se aceptan intentos. Nulo mientras no haya bloqueo.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([lastFailureAt])
  @@map("login_throttles")
}

/// Bitácora de seguridad: login (con éxito y fallido), cambios de 2FA, alta y revocación
/// de tokens, y borrados.
///
/// A propósito **sin clave foránea** hacia `User`. Una entrada de auditoría es un hecho
/// inmutable sobre algo que ya pasó y debe sobrevivir al borrado de quien lo provocó: con
/// `onDelete: SetNull` perderíamos quién hizo qué, y con `Cascade` quien borra su cuenta
/// borraría la evidencia. La integridad la garantiza la aplicación, no la base.
///
/// `userId` es opcional porque un intento de login contra un correo inexistente no tiene
/// usuario conocido.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// Qué se hizo, en inglés y en pasado: `login.succeeded`, `token.revoked`.
  action    String
  /// Sobre qué tipo de entidad: `user`, `personal_access_token`.
  entity    String
  /// Identificador de esa entidad. Texto libre: no toda entidad tendrá un UUID.
  entityId  String?  @map("entity_id")
  at        DateTime @default(now()) @db.Timestamptz(3)
  ip        String?
  userAgent String?  @map("user_agent")

  @@index([userId, at])
  @@map("audit_logs")
}

/// Tipo de transacción (glosario). También clasifica las categorías: una categoría pertenece a un
/// solo tipo, así que el formulario de un gasto variable solo ofrece categorías de gasto variable.
///
/// Los enums van como `ENUM` nativo de PostgreSQL: la base rechaza un valor inválido aunque alguien
/// se salte la aplicación. Agregar un valor es una migración trivial; quitar uno no, pero estos
/// salen del glosario y son estables. El dominio define los suyos y no importa estos.
enum TransactionType {
  INCOME
  FIXED_EXPENSE
  VARIABLE_EXPENSE
  SAVING
  INVESTMENT
  DEBT

  @@map("transaction_type")
}

enum PaymentMethodKind {
  ACCOUNT
  WALLET
  CREDIT_CARD
  CASH

  @@map("payment_method_kind")
}

enum Currency {
  PEN
  USD

  @@map("currency")
}

/// Categoría o subcategoría de un usuario. Cada usuario tiene su propia copia: editar la suya
/// no cambia la de nadie.
///
/// **Un solo nivel de jerarquía:** una subcategoría apunta a su categoría con `parentId`, y no
/// puede tener hijas. La base no puede exigir eso (tendría que mirar otra fila); lo exige el
/// dominio.
///
/// Lo que **sí** exige la base, con una clave foránea compuesta `(parentId, userId, type)`, es
/// que la categoría padre sea **del mismo usuario y del mismo tipo**: una subcategoría no puede
/// colgar de la categoría de otra persona aunque alguien adivine su id.
///
/// **No se borra, se archiva** (`archivedAt`): sus transacciones siguen apuntando a ella. Una
/// categoría con subcategorías tampoco se deja borrar (`NoAction`): primero hay que decidir qué
/// pasa con ellas.
///
/// El nombre es único entre hermanas del mismo tipo, **sin distinguir mayúsculas ni acentos**
/// ("Café" = "cafe"; la ñ sí cuenta) y contando las archivadas (para volver a usar un nombre se
/// restaura la archivada). Ese índice no se puede escribir en Prisma: vive en las migraciones
/// (`categories_unique_sibling_name`), igual que el `CHECK` del color `#RRGGBB`.
model Category {
  id           String          @id @default(uuid(7)) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  type         TransactionType
  name         String
  /// Categoría padre. Nulo = categoría de primer nivel.
  parentId     String?         @map("parent_id") @db.Uuid
  /// Color en hexadecimal (`#1E88E5`), para gráficos y listas.
  color        String
  /// Nombre del ícono en la web (`utensils`), no una imagen.
  icon         String
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?       @relation("CategoryHierarchy", fields: [parentId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)
  children     Category[]      @relation("CategoryHierarchy")
  transactions Transaction[]
  budgetLines  BudgetLine[]

  /// Destino de la clave foránea compuesta de `parent`. `id` ya es único; esto solo le da a
  /// PostgreSQL el índice que exige para referenciar las tres columnas juntas. Las búsquedas por
  /// `(userId, type)` usan el índice único de nombres, que empieza por esas columnas.
  @@unique([id, userId, type])
  @@map("categories")
}

/// Con qué se paga o dónde entra la plata: una cuenta, una billetera (Yape, Plin), una tarjeta
/// de crédito o efectivo.
///
/// **Nunca datos sensibles de tarjeta:** solo alias, banco y últimos 4 dígitos. Ni número
/// completo, ni CVV, ni vencimiento: no existe columna donde ponerlos, y `last4` solo acepta
/// cuatro dígitos (`payment_methods_last4_format`).
///
/// **Reglas por tipo** (`payment_methods_*_by_kind`, en la migración): una tarjeta de crédito
/// lleva sus últimos 4 (una cuenta puede; billetera y efectivo no), una cuenta o billetera lleva
/// moneda (una tarjeta bimoneda y el efectivo pueden no llevarla), y el efectivo no tiene banco.
/// Las mismas reglas viven en el dominio; aquí son la red por si alguien se lo salta.
///
/// **Alias único** por usuario, sin distinguir mayúsculas y contando los archivados
/// (`payment_methods_unique_alias`): es lo que se ve al registrar un gasto, y dos iguales serían
/// indistinguibles.
model PaymentMethod {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  kind         PaymentMethodKind
  /// Cómo lo llama el usuario: "Visa BCP", "Yape".
  alias        String
  /// Banco o entidad ("BCP", "Interbank"). Nulo para el efectivo.
  institution  String?
  /// Últimos 4 dígitos, para reconocer la tarjeta o cuenta. Nada más. `TEXT` y no `CHAR(4)`,
  /// que rellena con espacios: el `CHECK` de la migración ya exige exactamente cuatro dígitos.
  last4        String?
  /// Nula = acepta las dos monedas (tarjeta bimoneda).
  currency     Currency?
  archivedAt   DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfersOut Transfer[]        @relation("TransferFrom")
  transfersIn  Transfer[]        @relation("TransferTo")
  /// A lo sumo una (`payment_method_id` es único). Prisma la ve como lista porque la clave es
  /// compuesta y solo una de sus columnas es única.
  creditCards  CreditCard[]

  /// Destino de la clave foránea compuesta de `Transaction.paymentMethod`: `id` ya es único; esto
  /// solo le da a PostgreSQL el índice que exige para referenciar las dos columnas juntas.
  @@unique([id, userId])
  /// Destino de la clave foránea compuesta de `CreditCard.paymentMethod`: con `kind`, la base
  /// exige que la tarjeta configurada cuelgue de un método `CREDIT_CARD` de la misma cuenta.
  @@unique([id, userId, kind])
  /// Sin `@@index([userId])`: las búsquedas por usuario usan el índice único del alias, que
  /// empieza por esa columna.
  @@map("payment_methods")
}

/// De dónde llegó una transacción: a mano, desde el celular (H7) o importada de un CSV.
enum TransactionSource {
  MANUAL
  IOS_SHORTCUT
  ANDROID_AUTOMATION
  IMPORT

  @@map("transaction_source")
}

/// Un movimiento de plata: un ingreso, un gasto, un ahorro, una inversión o un pago de deuda.
///
/// **El monto siempre es positivo** (`transactions_amount_positive`): el signo lo da el tipo.
/// `NUMERIC(18,2)`, nunca un número de coma flotante.
///
/// **La fecha es de negocio** (`DATE`, sin hora): el día en que pasó, en la hora de Lima. No hay
/// fechas futuras, pero eso lo exige el dominio: la base no sabe qué día es "hoy" para el usuario.
///
/// **La categoría es del mismo usuario y del mismo tipo** que la transacción: lo exige la clave
/// foránea compuesta `(categoryId, userId, type)`, igual que en las subcategorías. El método de
/// pago, si lo hay, también es del mismo usuario (`(paymentMethodId, userId)`). Adivinar el id de
/// otra persona no alcanza para usar su categoría o su tarjeta.
///
/// Una categoría o un método con transacciones **no se borra** (`NoAction`): se archiva.
///
/// **Borrado lógico** (`deletedAt`): una transacción borrada se conserva para la auditoría y se
/// puede deshacer al momento; las consultas normales la excluyen.
model Transaction {
  id              String            @id @default(uuid(7)) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  /// Día en que pasó, sin hora.
  date            DateTime          @db.Date
  type            TransactionType
  categoryId      String            @map("category_id") @db.Uuid
  /// Siempre positivo; el signo lo da `type`.
  amount          Decimal           @db.Decimal(18, 2)
  currency        Currency
  description     String
  paymentMethodId String?           @map("payment_method_id") @db.Uuid
  /// Dónde se gastó ("TAMBO"), si se sabe.
  merchant        String?
  source          TransactionSource
  /// Captura del celular de la que salió. Sin relación todavía: la tabla `captures` llega en
  /// H7, y entonces una migración agrega la clave foránea.
  captureId       String?           @map("capture_id") @db.Uuid
  /// Huella (SHA-256) de la fila del CSV de la que salió, si se importó. Única por cuenta: la
  /// misma fila no se importa dos veces, aunque la transacción se corrija después.
  importKey       String?           @map("import_key")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Borrado lógico. Nulo = vigente.
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category          @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  tags            TransactionTag[]

  /// Destino de la clave foránea compuesta de `TransactionTag`: `id` ya es único; esto solo le da
  /// a PostgreSQL el índice que exige para referenciar las dos columnas juntas.
  @@unique([id, userId])
  /// Una fila del CSV entra una sola vez por cuenta; las que no se importaron (nulas) no chocan.
  @@unique([userId, importKey])
  /// Por donde se lista y se filtra siempre: las transacciones de un usuario en un rango de fechas.
  @@index([userId, date])
  /// Para que comprobar "¿esta categoría o este método tienen transacciones?" no recorra la tabla.
  @@index([categoryId])
  @@index([paymentMethodId])
  @@map("transactions")
}

/// Plata que pasa de una cuenta propia a otra: no es ingreso ni gasto (decidido el 2026-09-27).
/// Con monedas distintas guarda los dos montos, copiados del voucher: nunca se convierte.
model Transfer {
  id                  String            @id @default(uuid(7)) @db.Uuid
  userId              String            @map("user_id") @db.Uuid
  /// Día en que pasó, sin hora.
  date                DateTime          @db.Date
  fromPaymentMethodId String            @map("from_payment_method_id") @db.Uuid
  toPaymentMethodId   String            @map("to_payment_method_id") @db.Uuid
  /// Lo que salió de la cuenta de origen. Siempre positivo.
  amount              Decimal           @db.Decimal(18, 2)
  currency            Currency
  /// Lo que llegó a la cuenta de destino. Igual a `amount` si la moneda no cambia.
  receivedAmount      Decimal           @map("received_amount") @db.Decimal(18, 2)
  receivedCurrency    Currency          @map("received_currency")
  description         String
  source              TransactionSource
  /// Huella (SHA-256) de la fila del CSV de la que salió, si se importó. Única por cuenta.
  importKey           String?           @map("import_key")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Borrado lógico. Nulo = vigente.
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(3)
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  from                PaymentMethod     @relation("TransferFrom", fields: [fromPaymentMethodId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  to                  PaymentMethod     @relation("TransferTo", fields: [toPaymentMethodId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)

  /// Una fila del CSV entra una sola vez por cuenta; las que no se importaron (nulas) no chocan.
  @@unique([userId, importKey])
  /// Por donde se lista, igual que las transacciones.
  @@index([userId, date])
  /// Para que comprobar "¿este método tiene movimientos?" no recorra la tabla.
  @@index([fromPaymentMethodId])
  @@index([toPaymentMethodId])
  @@map("transfers")
}

/// Una marca para mirar las transacciones desde otro ángulo que la categoría (`almuerzo`,
/// `viaje-cusco`). Solo nombre; se crea al escribirla (decidido el 2026-09-28).
model Tag {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  /// Como la escribió el usuario la primera vez.
  name         String
  /// `searchKey(name)`: minúsculas y sin tildes. "Almuerzo" y "almuerzó" son la misma etiqueta.
  nameKey      String           @map("name_key")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  /// Una sola etiqueta por nombre y cuenta; la base decide si dos peticiones chocan.
  @@unique([userId, nameKey])
  /// Destino de la clave foránea compuesta de `TransactionTag`.
  @@unique([id, userId])
  @@map("tags")
}

/// Qué etiquetas tiene cada transacción. `userId` va en las dos claves foráneas: una transacción
/// no puede llevar la etiqueta de otra cuenta, aunque alguien adivine su id.
model TransactionTag {
  transactionId String      @map("transaction_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  /// Borrar una etiqueta la quita de todas las transacciones (decidido el 2026-09-28).
  tag           Tag         @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)

  @@id([transactionId, tagId])
  /// Para filtrar "las transacciones con esta etiqueta" sin recorrer la tabla.
  @@index([tagId])
  @@map("transaction_tags")
}

/// Presupuesto de un mes (H4): uno por mes y cuenta, con sus partidas.
model Budget {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  year      Int          @db.SmallInt
  /// 1 a 12. Un presupuesto es de un mes, no de un día: no es una fecha.
  month     Int          @db.SmallInt
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines     BudgetLine[]

  @@unique([userId, year, month])
  /// Destino de la clave foránea compuesta de `BudgetLine`: `id` ya es único; esto le da a
  /// PostgreSQL el índice que exige para referenciar las dos columnas juntas.
  @@unique([id, userId])
  @@map("budgets")
}

/// Cuánto se planea para una categoría **madre** en una moneda, en un mes (decisiones 2 y 3 de
/// H4, 2026-09-29). Suma lo real de la madre y de sus hijas; que sea madre lo valida el dominio.
///
/// Lleva su propio `userId` y el `type` de su categoría para que la base exija, con claves
/// compuestas, que el presupuesto y la categoría sean de la misma cuenta y que el tipo coincida.
model BudgetLine {
  id            String          @id @default(uuid(7)) @db.Uuid
  budgetId      String          @map("budget_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  categoryId    String          @map("category_id") @db.Uuid
  type          TransactionType
  /// Cero o más: 0 marca «aquí no gastar nada» (2026-09-29).
  plannedAmount Decimal         @map("planned_amount") @db.Decimal(18, 2)
  currency      Currency
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Directo al usuario, como `transactions`: al borrar la cuenta, la partida se va en el mismo
  /// nivel que sus categorías. Colgando solo del presupuesto quedaba un nivel más abajo, y la
  /// clave hacia `categories` se revisaba antes de borrarla.
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget        Budget          @relation(fields: [budgetId, userId], references: [id, userId], onDelete: Cascade)
  category      Category        @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)

  /// Una partida por categoría y moneda en cada mes (decisión 3).
  @@unique([budgetId, categoryId, currency])
  /// Para seguir una fusión de categorías sin recorrer la tabla.
  @@index([categoryId])
  @@map("budget_lines")
}

/// Cómo se calcula la fecha límite de pago de un estado de cuenta (decisión 5 de H5).
enum PaymentDueRule {
  /// N días después del corte.
  DAYS_AFTER_STATEMENT
  /// Un día fijo del mes; si es anterior o igual al día de corte, es del mes siguiente.
  DAY_OF_MONTH

  @@map("payment_due_rule")
}

/// Lo que hace falta para seguir una tarjeta de crédito: su línea, su día de corte y su regla de
/// pago (decisiones de H5, 2026-09-29). Cuelga de un método de pago `CREDIT_CARD` de `catalog`, que
/// ya guarda lo que la identifica (alias, banco, últimos 4): **aquí no se duplica**, y nunca hay
/// número completo, CVV ni vencimiento del plástico.
///
/// Lleva su propio `userId` y el `kind` de su método para que la clave foránea compuesta exija
/// que el método sea de la misma cuenta y de tipo `CREDIT_CARD` (el `CHECK` de la migración fija
/// el `kind`). Lo que se debe, la utilización y los estados de cuenta **no se guardan**: se
/// calculan al consultar con las transacciones.
model CreditCard {
  id                    String            @id @default(uuid(7)) @db.Uuid
  userId                String            @map("user_id") @db.Uuid
  /// Una configuración por método de pago.
  paymentMethodId       String            @unique @map("payment_method_id") @db.Uuid
  /// Siempre `CREDIT_CARD` (`CHECK`): solo existe para la clave foránea compuesta.
  kind                  PaymentMethodKind @default(CREDIT_CARD)
  /// Línea de crédito, cero o más. Una sola, en una moneda (decisión 3): la utilización solo
  /// cuenta la deuda en esa moneda.
  creditLimit           Decimal           @map("credit_limit") @db.Decimal(18, 2)
  creditLimitCurrency   Currency          @map("credit_limit_currency")
  /// 1 a 31. Si el mes no tiene ese día, el corte es el último día del mes (CLAUDE.md). La compra
  /// del día de corte entra en el estado que cierra ese día (decisión 4).
  statementDay          Int               @map("statement_day") @db.SmallInt
  paymentDueRule        PaymentDueRule    @map("payment_due_rule")
  /// Solo con `DAYS_AFTER_STATEMENT`, 1 a 60.
  dueDaysAfterStatement Int?              @map("due_days_after_statement") @db.SmallInt
  /// Solo con `DAY_OF_MONTH`, 1 a 31.
  dueDayOfMonth         Int?              @map("due_day_of_month") @db.SmallInt
  /// Lo que ya se debía antes de registrar en la app, uno por moneda (decisión 2), cero o más.
  /// Solo cuentan las compras y los pagos posteriores a `openingBalanceDate`.
  openingBalancePen     Decimal?          @map("opening_balance_pen") @db.Decimal(18, 2)
  openingBalanceUsd     Decimal?          @map("opening_balance_usd") @db.Decimal(18, 2)
  /// Fecha de negocio del saldo inicial; existe si y solo si hay algún saldo inicial.
  openingBalanceDate    DateTime?         @map("opening_balance_date") @db.Date
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Directo al usuario (lección de `budget_lines` en H4): al borrar la cuenta, la tarjeta se va
  /// en el mismo nivel que su método de pago.
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Sin cascada: un método con tarjeta configurada no se borra, se archiva.
  paymentMethod         PaymentMethod     @relation(fields: [paymentMethodId, userId, kind], references: [id, userId, kind], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("credit_cards")
}
