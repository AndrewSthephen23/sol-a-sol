generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// La URL de conexión vive en prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

/// Usuario de la plataforma. El modelo es multiusuario desde el día 1:
/// todas las tablas de negocio referenciarán `User.id`.
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  /// Secreto TOTP **cifrado** con AES-256-GCM. Existe desde que se empieza a activar el
  /// segundo factor, pero este no vale hasta que `totpConfirmedAt` deja de ser nulo.
  totpSecret      String?   @map("totp_secret")
  /// Cuándo se confirmó el segundo factor con un código. Nulo = no está activo.
  totpConfirmedAt DateTime? @map("totp_confirmed_at") @db.Timestamptz(3)
  /// Último periodo de 30 s usado. Impide reutilizar un código dentro de su ventana.
  totpLastCounter BigInt?   @map("totp_last_counter")
  locale          String    @default("es-PE")
  timezone        String    @default("America/Lima")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  personalAccessTokens PersonalAccessToken[]
  refreshTokens        RefreshToken[]
  recoveryCodes        RecoveryCode[]
  categories           Category[]
  paymentMethods       PaymentMethod[]

  @@map("users")
}

/// Código de recuperación del segundo factor: la salida cuando se pierde el teléfono.
///
/// Se guarda solo su hash SHA-256, como los refrescos y por el mismo motivo: son símbolos
/// aleatorios, no un secreto que alguien elija, y hay que poder buscarlos en un índice.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  /// Cada código sirve una sola vez.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// Sesión abierta en un navegador. El valor solo existe en la cookie del cliente: aquí se guarda
/// su hash SHA-256, así que una filtración de la base no permite suplantar a nadie.
///
/// Se usa SHA-256 y no argon2id a propósito: argon2 es lento **por diseño**, para proteger
/// secretos que elige una persona y se pueden adivinar. Este token son 256 bits aleatorios, que
/// no se adivinan, y el hash tiene que poder buscarse en un índice en cada refresco.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Cuándo se canjeó. Que llegue un token ya canjeado significa que alguien lo copió.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Token de larga duración para que un dispositivo (el celular) use la API sin la contraseña.
/// Solo se guarda su hash: el valor se muestra una vez al crearlo y no se puede recuperar.
///
/// El token lleva dentro su `id` (`sas_pat_<id><secreto>`), así que se busca por clave primaria
/// y el hash se compara en tiempo constante; por eso `tokenHash` no necesita índice.
model PersonalAccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// Nombre del dispositivo ("iPhone"), para poder revocar uno solo.
  name       String
  /// SHA-256 del secreto. Son 256 bits aleatorios: argon2 no aportaría nada (ver `RefreshToken`).
  tokenHash  String    @map("token_hash")
  /// Permisos mínimos del token; hoy solo existe `captures:write`.
  scopes     String[]
  /// Última vez que se usó, para saber si el token sigue vivo.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Siempre caduca: entre 1 y 365 días desde que se crea, 90 por defecto.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

/// Intentos fallidos de inicio de sesión de una llave, para el bloqueo progresivo.
///
/// Hay **dos llaves por intento** y se cuentan por separado: el correo (exista o no la cuenta)
/// y la IP. Solo por IP no protegería —quien tiene muchas IPs probaría sin freno—, y solo por
/// cuenta permitiría dejar a alguien fuera a propósito; con las dos, el tope de 15 minutos
/// limita cuánto puede durar eso.
///
/// El correo **no se guarda en claro**: la llave es `email:<sha256>`. Así la tabla no es una
/// lista de correos que alguien intentó, y aun así dos intentos contra el mismo correo caen en
/// la misma fila. La IP sí va tal cual: hay que poder leerla al investigar.
///
/// A propósito **sin clave foránea** hacia `User`: un intento contra un correo que no existe
/// no tiene usuario, y es justamente el caso que hay que frenar.
model LoginThrottle {
  key           String    @id
  failures      Int       @default(0)
  lastFailureAt DateTime  @map("last_failure_at") @db.Timestamptz(3)
  /// Hasta cuándo no se aceptan intentos. Nulo mientras no haya bloqueo.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)

  @@index([lastFailureAt])
  @@map("login_throttles")
}

/// Bitácora de seguridad: login (con éxito y fallido), cambios de 2FA, alta y revocación
/// de tokens, y borrados.
///
/// A propósito **sin clave foránea** hacia `User`. Una entrada de auditoría es un hecho
/// inmutable sobre algo que ya pasó y debe sobrevivir al borrado de quien lo provocó: con
/// `onDelete: SetNull` perderíamos quién hizo qué, y con `Cascade` quien borra su cuenta
/// borraría la evidencia. La integridad la garantiza la aplicación, no la base.
///
/// `userId` es opcional porque un intento de login contra un correo inexistente no tiene
/// usuario conocido.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// Qué se hizo, en inglés y en pasado: `login.succeeded`, `token.revoked`.
  action    String
  /// Sobre qué tipo de entidad: `user`, `personal_access_token`.
  entity    String
  /// Identificador de esa entidad. Texto libre: no toda entidad tendrá un UUID.
  entityId  String?  @map("entity_id")
  at        DateTime @default(now()) @db.Timestamptz(3)
  ip        String?
  userAgent String?  @map("user_agent")

  @@index([userId, at])
  @@map("audit_logs")
}

/// Tipo de transacción (glosario). También clasifica las categorías: una categoría pertenece a un
/// solo tipo, así que el formulario de un gasto variable solo ofrece categorías de gasto variable.
///
/// Los enums van como `ENUM` nativo de PostgreSQL: la base rechaza un valor inválido aunque alguien
/// se salte la aplicación. Agregar un valor es una migración trivial; quitar uno no, pero estos
/// salen del glosario y son estables. El dominio define los suyos y no importa estos.
enum TransactionType {
  INCOME
  FIXED_EXPENSE
  VARIABLE_EXPENSE
  SAVING
  INVESTMENT
  DEBT

  @@map("transaction_type")
}

enum PaymentMethodKind {
  ACCOUNT
  WALLET
  CREDIT_CARD
  CASH

  @@map("payment_method_kind")
}

enum Currency {
  PEN
  USD

  @@map("currency")
}

/// Categoría o subcategoría de un usuario. Cada usuario tiene su propia copia: editar la suya
/// no cambia la de nadie.
///
/// **Un solo nivel de jerarquía:** una subcategoría apunta a su categoría con `parentId`, y no
/// puede tener hijas. La base no puede exigir eso (tendría que mirar otra fila); lo exige el
/// dominio.
///
/// Lo que **sí** exige la base, con una clave foránea compuesta `(parentId, userId, type)`, es
/// que la categoría padre sea **del mismo usuario y del mismo tipo**: una subcategoría no puede
/// colgar de la categoría de otra persona aunque alguien adivine su id.
///
/// **No se borra, se archiva** (`archivedAt`): sus transacciones siguen apuntando a ella. Una
/// categoría con subcategorías tampoco se deja borrar (`NoAction`): primero hay que decidir qué
/// pasa con ellas.
///
/// El nombre es único entre hermanas del mismo tipo, **sin distinguir mayúsculas** y contando
/// las archivadas (para volver a usar un nombre se restaura la archivada). Ese índice no se
/// puede escribir en Prisma: vive en la migración (`categories_unique_sibling_name`).
model Category {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       TransactionType
  name       String
  /// Categoría padre. Nulo = categoría de primer nivel.
  parentId   String?         @map("parent_id") @db.Uuid
  /// Color en hexadecimal (`#1E88E5`), para gráficos y listas.
  color      String
  /// Nombre del ícono en la web (`utensils`), no una imagen.
  icon       String
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     Category?       @relation("CategoryHierarchy", fields: [parentId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction)
  children   Category[]      @relation("CategoryHierarchy")

  /// Destino de la clave foránea compuesta de `parent`. `id` ya es único; esto solo le da a
  /// PostgreSQL el índice que exige para referenciar las tres columnas juntas. Las búsquedas por
  /// `(userId, type)` usan el índice único de nombres, que empieza por esas columnas.
  @@unique([id, userId, type])
  @@map("categories")
}

/// Con qué se paga o dónde entra la plata: una cuenta, una billetera (Yape, Plin), una tarjeta
/// de crédito o efectivo.
///
/// **Nunca datos sensibles de tarjeta:** solo alias, banco y últimos 4 dígitos. Ni número
/// completo, ni CVV, ni vencimiento: no existe columna donde ponerlos, y `last4` solo acepta
/// cuatro dígitos (`payment_methods_last4_format`).
///
/// **Reglas por tipo** (`payment_methods_*_by_kind`, en la migración): una tarjeta de crédito
/// lleva sus últimos 4 (una cuenta puede; billetera y efectivo no), una cuenta o billetera lleva
/// moneda (una tarjeta bimoneda y el efectivo pueden no llevarla), y el efectivo no tiene banco.
/// Las mismas reglas viven en el dominio; aquí son la red por si alguien se lo salta.
///
/// **Alias único** por usuario, sin distinguir mayúsculas y contando los archivados
/// (`payment_methods_unique_alias`): es lo que se ve al registrar un gasto, y dos iguales serían
/// indistinguibles.
model PaymentMethod {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  kind        PaymentMethodKind
  /// Cómo lo llama el usuario: "Visa BCP", "Yape".
  alias       String
  /// Banco o entidad ("BCP", "Interbank"). Nulo para el efectivo.
  institution String?
  /// Últimos 4 dígitos, para reconocer la tarjeta o cuenta. Nada más. `TEXT` y no `CHAR(4)`,
  /// que rellena con espacios: el `CHECK` de la migración ya exige exactamente cuatro dígitos.
  last4       String?
  /// Nula = acepta las dos monedas (tarjeta bimoneda).
  currency    Currency?
  archivedAt  DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Sin `@@index([userId])`: las búsquedas por usuario usan el índice único del alias, que
  /// empieza por esa columna.
  @@map("payment_methods")
}
