{
  "name": "sol-a-sol",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma personal para ordenar mis finanzas y avanzar hacia la libertad financiera, sol a sol.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up --build",
    "dev:local": "turbo run dev",
    "docker:down": "docker compose down",
    "docker:test": "docker compose -f docker-compose.test.yml up --build --wait",
    "docker:test:down": "docker compose -f docker-compose.test.yml down --volumes",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:mutation": "turbo run test:mutation",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @sol-a-sol/api db:migrate",
    "db:studio": "pnpm --filter @sol-a-sol/api db:studio",
    "db:seed": "turbo run db:seed",
    "gen:module": "pnpm --filter @sol-a-sol/tooling build && node packages/tooling/dist/main.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "prettier": "@sol-a-sol/config/prettier",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@sol-a-sol/config": "workspace:*",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}
