{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@sol-a-sol/config/tsconfig/library.json",
  "compilerOptions": {
    // Paquete puro, como el dominio: sin tipos de Node ni del navegador. La prueba de fixtures
