# Instalación local sin sudo (ver README): no siempre está en el PATH de los clientes Git del editor.
export PATH="$HOME/.local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✖ gitleaks no está instalado. Instálalo (ver README, sección Requisitos) antes de hacer commit."
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
pnpm exec lint-staged
