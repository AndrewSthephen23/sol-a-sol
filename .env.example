# Variables para `docker compose`. Copiar a `.env` (no versionado) y ajustar.
# Compose falla al iniciar si falta alguna variable obligatoria.

# PostgreSQL
POSTGRES_USER=sol_a_sol
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sol_a_sol
# Puerto publicado solo en 127.0.0.1 (para Prisma Studio o pruebas desde el host)
POSTGRES_PORT=5432

# Puertos publicados en el host
API_PORT=3001
WEB_PORT=3000
